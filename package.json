{
  "name": "life-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "concurrently \"tsx watch src/server.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc && vite build",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "cli": "tsx src/cli.ts",
    "format": "prettier --write src web tests scripts *.ts *.js package.json tsconfig.json",
    "release:scan": "node scripts/release-scan.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "fastify": "5.12.5",
    "node-diff3": "3.2.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "concurrently": "9.2.4",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6"
  }
}
